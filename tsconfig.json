{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src-ts",
    "skipLibCheck": true
  },
  "include": ["src-ts/**/*"],
  "exclude": ["node_modules", "dist", "backup-python"]
}
